# Unreal binary content goes through Git LFS.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.locres filter=lfs diff=lfs merge=lfs -text
# Text stays text; normalise line endings on checkout.
*.cpp text eol=crlf
*.h text eol=crlf
*.cs text eol=crlf
*.ini text eol=crlf
*.md text eol=crlf
*.py text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cfg text eol=crlf
