#: Source/MVVMSample/Accessibility/GothamSettingsTable.cpp(76)
msgctxt "Gotham.Settings,HighContrastDesc"
msgid "Solid panels and brighter text and edges, for readability over busy scenes."
msgstr "Deckende Flächen sowie hellere Texte und Kanten für bessere Lesbarkeit vor unruhigen Szenen."

#. Key:	ReducedMotionLabel
#. SourceLocation:	Source/MVVMSample/Accessibility/GothamSettingsTable.cpp(82)
#: Source/MVVMSample/Accessibility/GothamSettingsTable.cpp(82)
msgctxt "Gotham.Settings,ReducedMotionLabel"
msgid "Reduced motion"
msgstr "Reduzierte Bewegung"

#. Key:	ReducedMotionDesc
#. SourceLocation:	Source/MVVMSample/Accessibility/GothamSettingsTable.cpp(83)
#: Source/MVVMSample/Accessibility/GothamSettingsTable.cpp(83)
msgctxt "Gotham.Settings,ReducedMotionDesc"
msgid "Turns off pops, slides, pulses, screen transitions and rain streaks. Colour cues stay on."
msgstr "Schaltet Aufploppen, Gleiten, Pulse, Bildschirmübergänge und Regenschlieren ab. Farbhinweise bleiben erhalten."

